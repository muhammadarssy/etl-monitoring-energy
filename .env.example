# Source — database collector (raw meter_readings)
SOURCE_DB_URL=postgresql://user:pass@localhost:5432/energy_db

# Target — data mart (boleh sama DB, schema datamart)
DATAMART_DB_URL=postgresql://user:pass@localhost:5432/energy_db

ETL_JOB_NAME=meter_readings_wbp
ETL_LAG_MINUTES=15
ETL_CHUNK_HOURS=1
ETL_LOOKBACK_HOURS=1
ETL_BOUNDARY_TOLERANCE_MINUTES=5
ETL_BACKFILL_DAYS=30

# Jam bisnis / tarif WBP-LWBP. Jangan ikut TZ OS (server Linux = UTC).
TIMEZONE=Asia/Jakarta
WBP_START_HOUR=18
WBP_END_HOUR=22

RUNTIME_JOB_NAME=meter_runtime_daily
# PT di bawah atau sama dengan nilai ini dianggap mati (noise residual, bukan 0 persis)
PT_ON_THRESHOLD=5

LOG_LEVEL=INFO

# --- Airflow (Docker di server Linux UTC) ---
# Isi otomatis oleh scripts/install_airflow_linux.sh
AIRFLOW_UID=50000
AIRFLOW_FERNET_KEY=
AIRFLOW_POSTGRES_PASSWORD=
AIRFLOW_WEBSERVER_PORT=8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=
_AIRFLOW_WWW_USER_EMAIL=airflow@localhost
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
AIRFLOW__WEBSERVER__DEFAULT_UI_TIMEZONE=Asia/Jakarta
