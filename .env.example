# Source — database collector (raw meter_readings)
SOURCE_DB_URL=postgresql://user:pass@localhost:5432/energy_db

# Target — data mart (boleh sama DB, schema datamart)
DATAMART_DB_URL=postgresql://user:pass@localhost:5432/energy_db

ETL_JOB_NAME=meter_readings_wbp
ETL_LAG_MINUTES=15
ETL_CHUNK_HOURS=1
ETL_LOOKBACK_HOURS=1
ETL_BOUNDARY_TOLERANCE_MINUTES=5
ETL_BACKFILL_DAYS=30

TIMEZONE=Asia/Jakarta
WBP_START_HOUR=18
WBP_END_HOUR=22

RUNTIME_JOB_NAME=meter_runtime_daily
# PT di bawah atau sama dengan nilai ini dianggap mati (noise residual, bukan 0 persis)
PT_ON_THRESHOLD=5

LOG_LEVEL=INFO
