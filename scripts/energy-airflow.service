[Unit]
Description=Energy ETL Apache Airflow (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/energy-etl
ExecStart=/usr/bin/docker compose -f docker-compose.airflow.yaml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.airflow.yaml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
